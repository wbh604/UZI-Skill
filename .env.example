# UZI-Skill · 本地环境变量（可选）
# 把本文件复制为 .env 并填入你自己的值：
#   cp .env.example .env
#   # 然后编辑 .env 填 key

# ─── 东财妙想 Skills Hub API（推荐配置）──────────────────────
# 设置后 UZI-Skill 会优先使用官方 NLP API 做：
#   1. 中文名纠错（"北部港湾" 自动识别为 "北部湾港"）
#   2. 股票行情快照（稳定性远高于爬 push2.eastmoney.com）
# 获取 key（免费）: https://dl.dfcfs.com/m/itc4
MX_APIKEY=

# ─── UZI Web / Docker 可选配置 ─────────────────────────────
# Web/API 端口
UZI_WEB_PORT=8977
# Web 访问地址。做公网反代时填写，例如 https://uzi.example.com，用于钉钉消息里的报告链接。
UZI_WEB_PUBLIC_BASE_URL=
# 默认分析深度：lite / medium / deep
UZI_WEB_DEFAULT_DEPTH=lite
# 同时运行的任务数。UZI 报告较重，建议保持 1。
UZI_WEB_MAX_PARALLEL_JOBS=1
# 最大排队任务数
UZI_WEB_MAX_QUEUE_SIZE=30
# DSA 风格目录。Docker Compose 默认会映射到 /app/data /app/logs /app/reports。
UZI_WEB_DATA_DIR=./data
UZI_WEB_LOGS_DIR=./logs
UZI_WEB_REPORTS_DIR=./reports

# ─── UZI Web 钉钉通知（可选）───────────────────────────────
# 钉钉群机器人的 Webhook URL。若机器人启用关键词安全，建议关键词包含“股票”。
DINGTALK_WEBHOOK_URL=
# 钉钉加签密钥，未开启加签可留空。
DINGTALK_SECRET=
# Web 页面提交任务时，是否默认勾选“完成后钉钉通知”。
UZI_DINGTALK_NOTIFY_DEFAULT=false

# ─── UZI Web 定时任务（可选）───────────────────────────────
# analyzer 服务开启后，会按这里的时间每天提交一批分析任务。
UZI_SCHEDULE_ENABLED=false
# 多个时间用英文逗号分隔，格式 HH:MM，例如 09:30,21:30
UZI_SCHEDULE_TIMES=21:30
# 多个标的用英文逗号分隔。
UZI_SCHEDULE_TICKERS=QQQ,NVDA,TSLA
# 定时任务分析深度：lite / medium / deep
UZI_SCHEDULE_DEPTH=lite
# 定时任务是否钉钉通知
UZI_SCHEDULE_NOTIFY=true

# ─── 其他可选 ─────────────────────────────────────────────
# STOCK_NO_CACHE=1        # 禁用所有 API 缓存，强制重新拉取
# UZI_NO_AUTO_OPEN=1      # 分析完不自动打开浏览器
